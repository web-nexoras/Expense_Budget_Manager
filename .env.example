PORT=8000
BASE_URL=/api/v1
CLIENT_URL=http://localhost:3000
DB_URL=mongodb://127.0.0.1:27017/expense_budget_manager
JWT_SEC=replace_with_a_long_random_secret

# Required for email verification/password reset
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com

# Optional (receipt image upload)
CLOUD_NAME=
API_KEY=
API_SECRET=

NODE_ENV=development
